<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#F4F1FA">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="My Contacts"
        android:textColor="#29213E"
        android:textSize="30sp"
        android:textStyle="bold"
        android:fontFamily="serif"
        android:layout_marginTop="12dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Your people, all in one place"
        android:textColor="#776D8D"
        android:textSize="15sp"
        android:layout_marginBottom="20dp" />

    <EditText
        android:id="@+id/etSearch"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:hint="Search by name..."
        android:singleLine="true"
        android:inputType="text"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textColor="#29213E"
        android:textColorHint="#958AA6"
        android:backgroundTint="#B7A1E8" />

    <Button
        android:id="@+id/btnRefresh"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Refresh Contacts"
        android:textAllCaps="false"
        android:layout_marginTop="10dp" />

    <TextView
        android:id="@+id/tvContactCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Your contacts · 0"
        android:textColor="#29213E"
        android:textSize="18sp"
        android:textStyle="bold"
        android:paddingTop="20dp"
        android:paddingBottom="12dp" />

    <ListView
        android:id="@+id/listContacts"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@android:color/transparent"
        android:divider="@android:color/transparent"
        android:dividerHeight="8dp"
        android:clipToPadding="false"
        android:paddingBottom="8dp" />

</LinearLayout>
